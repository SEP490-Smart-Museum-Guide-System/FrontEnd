# Vercel / smgs-web / Production: add this public build variable, then redeploy FE.
# Browser uploads go directly to the same authenticated BE, avoiding CDN timeouts.
VITE_UPLOAD_API_BASE_URL=https://smgs-52-62-165-39.sslip.io/api

# BE production environment (service smgs): merge this frontend origin into
# Cors:AllowedOrigins, preserving existing origins. Use a free array index if 0
# is already occupied. Restart BE after applying. No wildcard origin is needed.
Cors__AllowedOrigins__0=https://smgs-web.vercel.app
