# Development uses the Vite /api proxy. Production needs an /api reverse proxy
# or an explicit HTTPS backend URL, including /api, with its CORS origin allowed.
VITE_API_BASE_URL=/api
# Large multipart uploads should bypass a CDN reverse proxy. This public URL
# contains no AI service key; uploads still carry the signed-in user's JWT.
# BE must allow the exact frontend origin in Cors:AllowedOrigins.
VITE_UPLOAD_API_BASE_URL=

# Optional when the API proxy only forwards /api; use the backend HTTPS hub URL.
# VITE_NOTIFICATION_HUB_URL=https://your-backend.example/hubs/notifications
